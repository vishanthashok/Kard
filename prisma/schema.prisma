// Kard — universal rewards card for west campus
// Prisma schema using SQLite for local development.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  cardNumber   String        @unique
  points       Int           @default(0)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([cardNumber])
}

model Merchant {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  category     String
  // Points awarded per whole dollar spent.
  rewardRate   Float         @default(1)
  transactions Transaction[]
  rewards      Reward[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Reward {
  id          Int      @id @default(autoincrement())
  title       String
  // Points required to redeem this reward.
  cost        Int
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  merchantId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model Transaction {
  id           Int      @id @default(autoincrement())
  // "earn" when spending money, "redeem" when spending points.
  type         String
  // Dollar amount spent (earn transactions only).
  amount       Float    @default(0)
  // Points earned (earn) or spent (redeem).
  points       Int
  description  String   @default("")
  student      Student  @relation(fields: [studentId], references: [id])
  studentId    Int
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  merchantId   Int
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@index([merchantId])
}
